<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="VendorDatabase"
         connectionString="Server=localhost;Database=TESTDB2;Trusted_Connection=True;Encrypt=False"
         providerName="System.Data.SqlClient" />
    <add name="ConsentDatabase"
         connectionString="Server=localhost;Database=TESTDB2;Trusted_Connection=True;Encrypt=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="SourceData.RecentRowCount" value="200" />
    <add key="SourceData.CommandTimeoutSeconds" value="10" />
    <add key="Tablet.FallbackPollingMilliseconds" value="1000" />
    <add key="ConsentPolicy.Version" value="1.0" />
    <add key="ConsentPolicy.Title" value="Xác nhận xử lý thông tin hành khách" />
    <add key="ConsentPolicy.Content" value="Quý khách xác nhận đồng ý cho phép hệ thống lưu thông tin hành khách và thông tin chuyến bay để phục vụ quy trình tại khu vực CIP. Nội dung này đang là policy mẫu và cần được thay bằng văn bản chính thức trước khi triển khai thực tế." />
    <add key="ConsentPolicy.LanguageCode" value="vi-VN" />
    <add key="Admin.Username" value="admin" />
    <add key="Admin.Password" value="Cip@123456" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" requestValidationMode="4.0" maxRequestLength="1024" />
    <authentication mode="None" />
    <customErrors mode="RemoteOnly" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
